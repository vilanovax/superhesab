// SuperHesab — modular core schema
// Templates (Trip, Partner, …) are presentation/policy layers over Space.type.
// Do not fork per-template tables for core money flows.
// Currency: store amounts as Int in the smallest unit (e.g. Rials). Never use Float.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceType {
  TRIP
  PARTNER
  PERSONAL
  FAMILY
  BUILDING
  FUND
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum SpaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

enum SpaceCurrency {
  TOMAN
  RIAL
  USD
  AED
  EUR
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  ENTERTAINMENT
  SHOPPING
  OTHER
  /// Personal income categories (filter by transactionType = INCOME)
  SALARY
  TRANSFER
  OTHER_INCOME
  /// BUILDING shared-cost dictionary (phase 20)
  BUILDING_BILLS
  BUILDING_ELEVATOR
  BUILDING_CLEANING
  BUILDING_MAINTENANCE
  BUILDING_GARDENING
  BUILDING_SALARY
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  email     String?  @unique
  avatarUrl String?
  /// Ghost / placeholder member without app login (Path B)
  isVirtual Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedSpaces      Space[]         @relation("SpaceOwner")
  memberships      SpaceMember[]
  paidExpenses     Expense[]       @relation("ExpensePayer")
  createdExpenses  Expense[]       @relation("ExpenseCreatedBy")
  updatedExpenses  Expense[]       @relation("ExpenseUpdatedBy")
  expenseSplits    ExpenseSplit[]
  settlementsFrom  Settlement[]    @relation("SettlementFrom")
  settlementsTo    Settlement[]    @relation("SettlementTo")
  debtsCreated     Debt[]          @relation("DebtCreatedBy")
  debtPayments     DebtPayment[]   @relation("DebtPaymentCreatedBy")
  recurringRules   RecurringRule[] @relation("RecurringRuleCreatedBy")
  chargePayments   ChargePayment[] @relation("ChargePaymentCreatedBy")
  chargePaymentProofsUploaded ChargePaymentProof[] @relation("ChargePaymentProofUploadedBy")
  chargePaymentProofsReviewed ChargePaymentProof[] @relation("ChargePaymentProofReviewedBy")
  linkedUnits      Unit[]          @relation("UnitLinkedUser")
  buildingSuggestions BuildingSuggestion[] @relation("BuildingSuggestionAuthor")
  buildingAnnouncements BuildingAnnouncement[] @relation("BuildingAnnouncementAuthor")
  buildingNotifications BuildingNotification[] @relation("BuildingNotificationRecipient")
  fundPaymentsCreated   FundPayment[]          @relation("FundPaymentCreatedBy")
  fundProofsUploaded    FundPaymentProof[]     @relation("FundProofUploadedBy")
  fundProofsReviewed    FundPaymentProof[]     @relation("FundProofReviewedBy")
  categoryPoliciesOwned SpaceCategoryPolicy[]  @relation("CategoryPolicyOwner")

  @@index([phone])
  @@index([email])
  @@index([isVirtual])
}

model Space {
  id                 String        @id @default(cuid())
  name               String
  type               SpaceType
  currency           SpaceCurrency @default(TOMAN)
  /// Round settlement/balance amounts up to nearest thousand for easier cash splits
  roundUpToThousand  Boolean       @default(false)
  /// Monthly spend target (PERSONAL). Null = no budget tracking.
  monthlyBudget      Int?
  /// When set, space is hidden from home and blocked until restored or permanently deleted.
  archivedAt         DateTime?
  /// BUILDING: preferred Jalali plan year (e.g. 1405). Null = current Jalali year.
  defaultPlanYear    Int?
  ownerId            String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  owner        User             @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      SpaceMember[]
  expenses     Expense[]
  settlements  Settlement[]
  checklist    ChecklistItem[]
  debts        Debt[]
  categoryBudgets CategoryBudget[]
  recurringRules  RecurringRule[]
  units           Unit[]
  chargePlans     ChargePlan[]
  buildingSuggestions BuildingSuggestion[]
  buildingAnnouncements BuildingAnnouncement[]
  buildingNotifications BuildingNotification[]
  savingsPots         SavingsPot[]
  internalLoans       InternalLoan[]
  fundPlan            FundPlan?
  fundTurns           FundTurn[]
  fundPayments        FundPayment[]
  fundPaymentProofs   FundPaymentProof[]
  categoryPolicies    SpaceCategoryPolicy[]

  @@index([ownerId])
  @@index([type])
  @@index([archivedAt])
}

model SpaceMember {
  id           String    @id @default(cuid())
  spaceId      String
  userId       String
  role         SpaceRole @default(EDITOR)
  /// Default EQUAL weight in half-units (1 = 0.5×, 2 = 1×, 4 = 2×)
  defaultShare Int       @default(2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  savingsTransactions SavingsTransaction[]
  loansGiven          InternalLoan[] @relation("InternalLoanFrom")
  loansReceived       InternalLoan[] @relation("InternalLoanTo")
  fundTurnsWon        FundTurn[]     @relation("FundTurnWinner")
  fundPayments        FundPayment[]
  fundPaymentProofs   FundPaymentProof[]

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId])
}

model Expense {
  id               String          @id @default(cuid())
  spaceId          String
  title            String
  /// Amount in smallest currency unit (never Float)
  totalAmount      Int
  paidById         String
  /// Who first logged the expense (audit)
  createdById      String?
  /// Who last edited the expense (audit)
  updatedById      String?
  /// EXPENSE (default) or INCOME — same table, template decides UI
  transactionType  TransactionType @default(EXPENSE)
  category         ExpenseCategory @default(OTHER)
  /// Optional freeform label (custom category). When set, UI/reports prefer this over CATEGORY_LABELS[category].
  categoryLabel    String?
  /// When true, title-based auto-categorization will not overwrite category
  isCategoryLocked Boolean         @default(false)
  date             DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  splits    ExpenseSplit[]
  recurringOccurrence RecurringOccurrence?

  @@index([spaceId])
  @@index([paidById])
  @@index([createdById])
  @@index([updatedById])
  @@index([date])
  @@index([category])
  @@index([transactionType])
  @@index([spaceId, date, transactionType])
}

model ExpenseSplit {
  id         String @id @default(cuid())
  expenseId  String
  userId     String
  /// Amount this user owes for the expense (smallest currency unit)
  owedAmount Int
  /// Weight in half-units at expense time (EQUAL); EXACT rows store 2 (= 1×)
  share      Int    @default(2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@index([expenseId])
}

model Settlement {
  id         String           @id @default(cuid())
  spaceId    String
  fromUserId String
  toUserId   String
  /// Amount in smallest currency unit
  amount     Int
  status     SettlementStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([spaceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  spaceId     String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([createdAt])
}

/// Personal lend/borrow ledger — isolated from Expense & Settlement (see debt-module-prd).
enum DebtType {
  LENT
  BORROWED
}

enum DebtStatus {
  ACTIVE
  SETTLED
}

model Debt {
  id             String     @id @default(cuid())
  spaceId        String
  /// LENT = طلب از دیگران؛ BORROWED = بدهی به دیگران
  type           DebtType
  counterparty   String
  /// Total principal in smallest currency unit
  initialAmount  Int
  dueDate        DateTime?
  status         DebtStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments  DebtPayment[]

  @@index([spaceId])
  @@index([status])
  @@index([dueDate])
  @@index([spaceId, status])
  @@index([createdById])
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  /// Partial repayment / receipt in smallest currency unit
  amount      Int
  date        DateTime @default(now())
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  debt      Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdBy User @relation("DebtPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([debtId])
  @@index([createdById])
  @@index([date])
}

/// PERSONAL depth: per-category monthly spend caps (see personal-depth-prd).
model CategoryBudget {
  id        String          @id @default(cuid())
  spaceId   String
  category  ExpenseCategory
  /// Monthly cap in smallest currency unit
  amount    Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, category])
  @@index([spaceId])
}

/// PERSONAL depth: monthly recurring → Expense on space open.
model RecurringRule {
  id              String          @id @default(cuid())
  spaceId         String
  title           String
  /// Amount in smallest currency unit
  amount          Int
  transactionType TransactionType @default(EXPENSE)
  category        ExpenseCategory @default(OTHER)
  /// Day of Tehran month to fire (1–28)
  dayOfMonth      Int
  active          Boolean         @default(true)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  space        Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("RecurringRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  occurrences  RecurringOccurrence[]

  @@index([spaceId])
  @@index([spaceId, active])
  @@index([createdById])
}

model RecurringOccurrence {
  id        String   @id @default(cuid())
  ruleId    String
  /// Tehran calendar month key yyyy-mm
  monthKey  String
  expenseId String   @unique
  createdAt DateTime @default(now())

  rule    RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  expense Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([ruleId, monthKey])
  @@index([ruleId])
  @@index([monthKey])
}

/// Building charge payment status (see building-template-prd).
enum ChargeStatus {
  DUE
  PARTIAL
  PAID
  WAIVED
}

/// خانه: دستهٔ خصوصی vs مشترک (نبود ردیف = SHARED). See home-category-privacy-prd.
enum CategoryVisibility {
  SHARED
  PRIVATE
}

/// خانه: سیاست دیده‌شدن دسته. فقط ردیف PRIVATE لازم است؛ SHARED = پیش‌فرض.
model SpaceCategoryPolicy {
  id          String             @id @default(cuid())
  spaceId     String
  category    ExpenseCategory
  visibility  CategoryVisibility @default(PRIVATE)
  ownerUserId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner User  @relation("CategoryPolicyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([spaceId, category])
  @@index([spaceId])
  @@index([ownerUserId])
}

/// BUILDING: apartment / unit under a space (additive; not a User).
model Unit {
  id         String   @id @default(cuid())
  spaceId    String
  /// Display name / unit number (e.g. "۱۲")
  name       String
  /// Optional area in whole square meters
  area       Int?
  /// Charge coefficient in thousandths (1000 = 1.0×). Never Float.
  multiplier Int      @default(1000)
  isActive   Boolean  @default(true)
  /// Unique invite link token — possession authorizes claim (phase 22).
  inviteToken String  @unique @default(cuid())
  /// Resident who claimed this unit (VIEWER portal).
  linkedUserId String?
  linkedAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  space      Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  linkedUser User?           @relation("UnitLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  payments   ChargePayment[]
  suggestions BuildingSuggestion[]

  @@unique([spaceId, linkedUserId])
  @@index([spaceId])
  @@index([spaceId, isActive])
  @@index([linkedUserId])
  @@index([inviteToken])
}

/// BUILDING: annual base charge plan for a space.
model ChargePlan {
  id         String   @id @default(cuid())
  spaceId    String
  /// Jalali year used as plan key (e.g. 1405)
  year       Int
  /// Monthly base charge in smallest currency unit
  baseCharge Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, year])
  @@index([spaceId])
}

/// BUILDING: one recorded charge outcome per unit × year × month (no pre-allocation).
model ChargePayment {
  id          String       @id @default(cuid())
  unitId      String
  year        Int
  /// Calendar month 1–12
  month       Int
  /// Amount received / credited in smallest currency unit
  amount      Int
  status      ChargeStatus @default(PAID)
  date        DateTime     @default(now())
  note        String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  unit      Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User @relation("ChargePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  proofs    ChargePaymentProof[]

  @@unique([unitId, year, month])
  @@index([unitId])
  @@index([year, month])
  @@index([status])
  @@index([createdById])
}

/// BUILDING: resident payment receipt uploaded to object storage (phase 28).
enum ChargeProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model ChargePaymentProof {
  id           String            @id @default(cuid())
  paymentId    String
  uploadedById String
  storageKey   String
  mimeType     String
  byteSize     Int
  note         String?
  status       ChargeProofStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  payment    ChargePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("ChargePaymentProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("ChargePaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
}

/// BUILDING B2B2C: resident suggestion / request box (phase 24).
enum SuggestionStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED
}

model BuildingSuggestion {
  id          String           @id @default(cuid())
  spaceId     String
  unitId      String
  authorId    String
  title       String
  body        String
  status      SuggestionStatus @default(OPEN)
  /// Optional manager reply / note
  managerNote String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  unit   Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  author User  @relation("BuildingSuggestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([spaceId])
  @@index([spaceId, status])
  @@index([unitId])
  @@index([authorId])
  @@index([createdAt])
}

/// BUILDING B2B2C: manager → residents announcement board (phase 26).
model BuildingAnnouncement {
  id         String    @id @default(cuid())
  spaceId    String
  authorId   String
  title      String
  body       String
  pinned     Boolean   @default(false)
  /// Soft-hide from resident feed without hard delete.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author User  @relation("BuildingAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([spaceId])
  @@index([spaceId, archivedAt])
  @@index([spaceId, pinned])
  @@index([authorId])
  @@index([createdAt])
}

/// BUILDING B2B2C: in-app inbox for linked residents (phase 27).
enum BuildingNotificationKind {
  ANNOUNCEMENT
  CHARGE_PAYMENT
  PAYMENT_PROOF
}

model BuildingNotification {
  id        String                   @id @default(cuid())
  spaceId   String
  /// Recipient (linked resident user).
  userId    String
  kind      BuildingNotificationKind
  title     String
  body      String
  /// Deep-link tab in resident portal: announcements | payments
  hrefTab   String?
  /// Related announcementId or chargePaymentId
  refId     String?
  readAt    DateTime?
  createdAt DateTime                 @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation("BuildingNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([spaceId, userId])
  @@index([spaceId, kind])
  @@index([createdAt])
}

// ——— FAMILY additive: savings pot + internal loan (see docs/family-savings-loan-prd.md) ———

enum SavingsPotStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum InternalLoanStatus {
  ACTIVE
  SETTLED
}

/// FAMILY: shared savings goal — isolated from Expense (no monthly budget pollution).
model SavingsPot {
  id           String           @id @default(cuid())
  spaceId      String
  title        String
  /// Target amount in smallest currency unit
  targetAmount Int
  deadline     DateTime?
  status       SavingsPotStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  space        Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions SavingsTransaction[]

  @@index([spaceId])
  @@index([spaceId, status])
  @@index([deadline])
}

model SavingsTransaction {
  id        String                  @id @default(cuid())
  potId     String
  /// SpaceMember who deposited / withdrew
  memberId  String
  /// Amount in smallest currency unit (always > 0)
  amount    Int
  type      SavingsTransactionType
  note      String?
  date      DateTime                @default(now())
  createdAt DateTime                @default(now())

  pot    SavingsPot  @relation(fields: [potId], references: [id], onDelete: Cascade)
  member SpaceMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([potId])
  @@index([memberId])
  @@index([date])
  @@index([potId, type])
}

/// FAMILY: lend between members — isolated from external Debt and Settlement.
model InternalLoan {
  id             String             @id @default(cuid())
  spaceId        String
  fromMemberId   String
  toMemberId     String
  /// Principal in smallest currency unit
  initialAmount  Int
  dueDate        DateTime?
  status         InternalLoanStatus @default(ACTIVE)
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  space      Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fromMember SpaceMember          @relation("InternalLoanFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   SpaceMember          @relation("InternalLoanTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  payments   InternalLoanPayment[]

  @@index([spaceId])
  @@index([spaceId, status])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([dueDate])
}

model InternalLoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  /// Partial repayment in smallest currency unit
  amount    Int
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  loan InternalLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([date])
}

// ——— FUND rotating savings (ROSCA) — see docs/fund-template-prd.md ———

enum FundTurnStatus {
  OPEN
  ASSIGNED
}

/// FUND: one plan per space (share amount + cycle length).
model FundPlan {
  id           String   @id @default(cuid())
  spaceId      String   @unique
  /// Payment for 1.0× share (2 half-units) in smallest currency unit
  shareAmount  Int
  /// Number of periods / turns in the cycle
  periodCount  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

/// FUND: one slot in the cycle; winner assigned manually in Phase A.
model FundTurn {
  id             String         @id @default(cuid())
  spaceId        String
  /// 1 … FundPlan.periodCount
  periodIndex    Int
  winnerMemberId String?
  status         FundTurnStatus @default(OPEN)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  space  Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  winner SpaceMember? @relation("FundTurnWinner", fields: [winnerMemberId], references: [id], onDelete: SetNull)

  @@unique([spaceId, periodIndex])
  @@index([spaceId])
  @@index([winnerMemberId])
  @@index([status])
}

/// FUND: member payment for a period (manager tick). Isolated from Expense.
model FundPayment {
  id          String   @id @default(cuid())
  spaceId     String
  periodIndex Int
  memberId    String
  /// Amount in smallest currency unit
  amount      Int
  date        DateTime @default(now())
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member    SpaceMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User        @relation("FundPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([spaceId, periodIndex, memberId])
  @@index([spaceId, periodIndex])
  @@index([memberId])
  @@index([createdById])
}

enum FundProofStatus {
  PENDING
  APPROVED
  REJECTED
}

/// FUND Phase B: member payment receipt (S3/R2), reviewed by OWNER/EDITOR.
model FundPaymentProof {
  id           String          @id @default(cuid())
  spaceId      String
  periodIndex  Int
  memberId     String
  uploadedById String
  storageKey   String
  mimeType     String
  byteSize     Int
  note         String?
  status       FundProofStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  space      Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member     SpaceMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  uploadedBy User        @relation("FundProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?       @relation("FundProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([spaceId, periodIndex])
  @@index([spaceId, status])
  @@index([memberId])
  @@index([uploadedById])
  @@index([createdAt])
}
