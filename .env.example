# Postgres connection (Prisma + @prisma/adapter-pg).
# Local Docker default — host port 15432 (see docker-compose.yml).
# connection_limit caps the pg pool per Node process (important under multi-instance / serverless).
# pool_timeout is seconds to wait for a free connection before erroring.
# Remote: URL-encode special chars in password (e.g. @ → %40).
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@HOST:PORT/superhesab?schema=public&connection_limit=10&pool_timeout=20"
DATABASE_URL="postgresql://superhesab:superhesab@localhost:15432/superhesab?schema=public&connection_limit=10&pool_timeout=20"

# Auth (mock OTP). Use a long random string in production.
SESSION_SECRET="dev-superhesab-session-secret-change-me-32chars"

# App
NEXT_PUBLIC_APP_NAME="SuperHesab"
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# S3-compatible object storage (AWS S3 or Cloudflare R2) — payment proofs
# Leave unset in local smoke to skip upload tests.
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="superhesab"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://files.example.com"
