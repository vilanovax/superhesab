# Postgres on this host via Docker network (container name: postgresql)
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
# URL-encode special chars in password (e.g. @ → %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgresql:5432/superhesab?schema=public&connection_limit=10&pool_timeout=20"

# Auth. Use a long random string in production.
SESSION_SECRET="dev-superhesab-session-secret-change-me-32chars"
# Mock OTP is 111111 by default (testing). Set false to disable OTP login until SMS ships.
# ALLOW_MOCK_OTP=false
# Session cookie Secure flag. Leave unset to infer from NEXT_PUBLIC_APP_URL /
# NODE_ENV. Set false for local `npm start` on http://localhost:3003.
# COOKIE_SECURE=false
# Comma-separated phones promoted to platform ADMIN (access /admin).
# PLATFORM_ADMIN_PHONES="09120000001"

# App
NEXT_PUBLIC_APP_NAME="SuperHesab"
NEXT_PUBLIC_APP_URL="https://app.superhesab.ir"

# S3-compatible object storage (AWS S3 or Cloudflare R2) — payment proofs
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="superhesab"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://files.example.com"
