# Local Docker Postgres — host port 15432 (see docker-compose.yml)
DATABASE_URL="postgresql://superhesab:superhesab@localhost:15432/superhesab?schema=public"

# Auth (mock OTP). Use a long random string in production.
SESSION_SECRET="dev-superhesab-session-secret-change-me-32chars"

# App
NEXT_PUBLIC_APP_NAME="SuperHesab"
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# S3-compatible object storage (AWS S3 or Cloudflare R2) — payment proofs
# Leave unset in local smoke to skip upload tests.
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="superhesab"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://files.example.com"
